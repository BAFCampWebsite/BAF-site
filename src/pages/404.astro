<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#4A8C5C">
    <title>404 — BAF Camp</title>
    <link rel="stylesheet" href="/style.css">
  </head>
  <body>
    <main style="
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 48px 24px;
      text-align: center;
    ">
      <h1 style="
        font-family: var(--font-display);
        font-size: clamp(6rem, 18vw, 12rem);
        line-height: .85;
        letter-spacing: .04em;
        color: var(--rose);
        text-shadow: var(--contour-bd-lg);
        margin-bottom: 16px;
      ">404</h1>

      <p style="
        font-family: var(--font-display);
        font-size: clamp(1.4rem, 4vw, 2.2rem);
        color: var(--encre);
        margin-bottom: 32px;
      ">
        <span lang="fr">Page introuvable</span>
        <span style="opacity:.3;margin:0 8px">·</span>
        <span lang="en">Page not found</span>
        <span style="opacity:.3;margin:0 8px">·</span>
        <span lang="nl">Pagina niet gevonden</span>
      </p>

      <p style="
        font-family: var(--font-serif);
        font-size: var(--text-lg);
        color: var(--gris-encre);
        max-width: 480px;
        line-height: 1.7;
        margin-bottom: 40px;
      ">
        <span lang="fr">Désolé, cette page n'existe pas ou a été déplacée.</span><br>
        <span lang="en">Sorry, this page doesn't exist or has moved.</span><br>
        <span lang="nl">Sorry, deze pagina bestaat niet of is verplaatst.</span>
      </p>

      <div class="cluster" style="justify-content:center;">
        <a href="/fr/" class="btn btn-primary">Français</a>
        <a href="/en/" class="btn btn-primary">English</a>
        <a href="/nl/" class="btn btn-primary">Nederlands</a>
      </div>
    </main>
  </body>
</html>
