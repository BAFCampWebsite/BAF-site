---
// Print-only page: the full programme timeline, server-rendered at build time
// into a self-contained HTML file (all CSS inlined, no client JS, no external
// assets) so it prints correctly from any browser via Print → Save as PDF
// (⌘P) — see CALENDAR.md → “Print / PDF export”. The print shell (HTML
// skeleton + inlined stylesheet) lives in src/layouts/PrintLayout.astro.
export { getLocaleStaticPaths as getStaticPaths } from "../../i18n/getStaticPaths";

import { setRequestLocale } from 'astro-intl';
import { getLocale } from "astro-intl";
import { getTranslations } from "../../i18n/getTranslations";
import teamupEvents from "../../../public/teamup-events.json";
import {
  buildCalendarEvents,
  buildCategoryMeta,
} from "../../lib/calendar";
import {
  getTimelineDayMetrics,
  renderTimelineDay,
} from "../../lib/calendar-client";
import type { TimelineEvent } from "../../lib/calendar-client";
import PrintLayout from "../../layouts/PrintLayout.astro";

await setRequestLocale(Astro.url);
const lang = getLocale();
const t = getTranslations("programme");

const categoryMeta = buildCategoryMeta(t as unknown as (key: string) => string);
const calendarEvents = buildCalendarEvents(
  (teamupEvents?.events ?? []) as Record<string, unknown>[],
  lang,
  categoryMeta,
  t("calendar.filters.workshops"),
) as unknown as TimelineEvent[];
const noLocationLabel = t("calendar.noLocation");
const timelineOtherLabel = t("calendar.timelineOther");

// Printable area of one A4 landscape sheet (297×210mm) with the 10mm margins
// declared in print.css, at 96dpi. The estimates below cover the day heading
// (+ section gap) and the location-header row; the 0.96 factor is a safety
// margin for rounding and font metrics.
const mmToPx = (mm: number) => (mm / 25.4) * 96;
const pageW = Math.round(mmToPx(297) - 2 * mmToPx(10));
const pageH = Math.round(mmToPx(210) - 2 * mmToPx(10));
const headingEstimate = 44;
const headerEstimate = 36;

const dayKeys = [...new Set(calendarEvents.map((e) => e.dayKey))];
const pages = dayKeys.map((dayKey) => {
  const dayEvents = calendarEvents.filter((e) => e.dayKey === dayKey);
  const { minWidth, height } = getTimelineDayMetrics(dayKey, dayEvents);
  const scale =
    Math.min(pageW / minWidth, (pageH - headingEstimate) / (headerEstimate + height), 1) * 0.96;
  const fit =
    scale < 1
      ? {
          width: Math.round(minWidth * scale),
          height: Math.round((headerEstimate + height) * scale),
          scale,
        }
      : null;
  // One .print-page per day: print.css forces a page break after each one.
  const section = renderTimelineDay(dayKey, dayEvents, noLocationLabel, timelineOtherLabel, null, fit);
  return `<div class="print-page">${section}</div>`;
});
---

<PrintLayout
  title={t("hero.title")}
  stylesheets={[
    "src/styles/calendar/base.css",
    "src/styles/calendar/timeline.css",
  ]}
  printStylesheet="src/styles/calendar/print.css"
  mainId="calendarEvents"
  mainClass="calendar-grid"
>
  <Fragment slot="instructions">
    <p class="print-instructions-title">{t("calendar.printInstructions.title")}</p>
    <ol>
      <li>{t("calendar.printInstructions.step1")}</li>
      <li>{t("calendar.printInstructions.step2")}</li>
      <li>{t("calendar.printInstructions.step3")}</li>
    </ol>
  </Fragment>
  {pages.map((page) => <Fragment set:html={page} />)}
</PrintLayout>
