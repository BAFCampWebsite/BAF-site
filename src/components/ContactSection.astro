---
import { getTranslations } from '../i18n/getTranslations';

const t = getTranslations('contact');
---

<section class="section-contact" id="contact">
  <div class="section-contact-shell">
    <p class="section-eyebrow section-contact-eyebrow">{t('eyebrow')}</p>
    <h2 class="section-title section-contact-title">{t('title')}</h2>
    <p class="contact-sub">{t('text')}</p>
    <a href="mailto:contact@bafcamp.be" class="btn btn-primary section-contact-cta">✉ {t('btnText')}</a>
  </div>
</section>
