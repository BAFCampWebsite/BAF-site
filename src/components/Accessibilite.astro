const sensorialItems = [
  { type: "yes", text: t("accessibilite.sensorial.items.i0") },
  { type: "yes", text: t("accessibilite.sensorial.items.i1") },
  { type: "yes", text: t("accessibilite.sensorial.items.i2") },
  { type: "yes", text: t("accessibilite.sensorial.items.i3") },
  { type: "no", text: t("accessibilite.sensorial.items.i4") },
  { type: "no", text: t("accessibilite.sensorial.items.i5") },
  { type: "no", text: t("accessibilite.sensorial.items.i6") },
