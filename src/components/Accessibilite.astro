---
import { getLocale } from "astro-intl";
import { getTranslations } from "../i18n/getTranslations";

const lang = getLocale();
const t = getTranslations("infos");

const careItems = [
  { type: "yes", text: t("accessibilite.care.items.i0") },
  { type: "yes", text: t("accessibilite.care.items.i1") },
  { type: "yes", text: t("accessibilite.care.items.i2") },
  { type: "yes", text: t("accessibilite.care.items.i3") },
  { type: "yes", text: t("accessibilite.care.items.i4") },
  { type: "no", text: t("accessibilite.care.items.i5") },
  { type: "no", text: t("accessibilite.care.items.i6") },
];

