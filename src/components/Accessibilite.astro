  { type: "yes", text: t("accessibilite.formation.items.i0") },
  { type: "yes", text: t("accessibilite.formation.items.i1") },
  { type: "yes", text: t("accessibilite.formation.items.i2") },
  { type: "no", text: t("accessibilite.formation.items.i3") },
];

const generalItems = [
  { type: "yes", text: t("accessibilite.general.items.i0") },
  { type: "yes", text: t("accessibilite.general.items.i1") },
  { type: "yes", text: t("accessibilite.general.items.i2") },
  { type: "yes", text: t("accessibilite.general.items.i3") },
  { type: "yes", text: t("accessibilite.general.items.i4") },
  { type: "no", text: t("accessibilite.general.items.i5") },
];

const childrenItems = [
  { type: "yes", text: t("accessibilite.children.items.i0") },
  { type: "yes", text: t("accessibilite.children.items.i1") },
  { type: "yes", text: t("accessibilite.children.items.i2") },
  { type: "yes", text: t("accessibilite.children.items.i3") },
  { type: "yes", text: t("accessibilite.children.items.i4") },
];

const visualItems = [
  { type: "yes", text: t("accessibilite.visual.items.i0") },
  { type: "yes", text: t("accessibilite.visual.items.i1") },
  { type: "yes", text: t("accessibilite.visual.items.i2") },
  { type: "no", text: t("accessibilite.visual.items.i3") },
  { type: "no", text: t("accessibilite.visual.items.i4") },
  { type: "no", text: t("accessibilite.visual.items.i5") },
];

const auditoryItems = [
  { type: "yes", text: t("accessibilite.auditory.items.i0") },
  { type: "no", text: t("accessibilite.auditory.items.i1") },
  { type: "no", text: t("accessibilite.auditory.items.i2") },
  { type: "no", text: t("accessibilite.auditory.items.i3") },
  { type: "no", text: t("accessibilite.auditory.items.i4") },
];

const spatialItems = [
  {
    type: "yes",
    text: t("accessibilite.spatial.items.i0"),
    details: {
      label: t("accessibilite.spatial.planLabel"),
      images: ["/plan-pmr-1.png", "/plan-pmr-2.png"],
    },
  },
  { type: "yes", text: t("accessibilite.spatial.items.i1") },
  { type: "yes", text: t("accessibilite.spatial.items.i2") },
  { type: "yes", text: t("accessibilite.spatial.items.i3") },
  { type: "yes", text: t("accessibilite.spatial.items.i4") },
  { type: "no", text: t("accessibilite.spatial.items.i5") },
  { type: "no", text: t("accessibilite.spatial.items.i6") },
  { type: "no", text: t("accessibilite.spatial.items.i7") },
