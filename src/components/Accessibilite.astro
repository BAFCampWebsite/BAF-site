  { type: "yes", text: t("accessibilite.sanitary.items.i0") },
  { type: "yes", text: t("accessibilite.sanitary.items.i1") },
  { type: "yes", text: t("accessibilite.sanitary.items.i2") },
  { type: "no", text: t("accessibilite.sanitary.items.i3") },
  { type: "no", text: t("accessibilite.sanitary.items.i4") },
];

const materialItems = [
  { label: t("accessibilite.material.food.label"), text: t("accessibilite.material.food.text") },
  { label: t("accessibilite.material.sun.label"), text: t("accessibilite.material.sun.text") },
  { label: t("accessibilite.material.hygiene.label"), text: t("accessibilite.material.hygiene.text") },
  { label: t("accessibilite.material.money.label"), text: t("accessibilite.material.money.text") },
  { label: t("accessibilite.material.clothes.label"), text: t("accessibilite.material.clothes.text") },
  { label: t("accessibilite.material.water.label"), text: t("accessibilite.material.water.text") },
  { label: t("accessibilite.material.tent.label"), text: t("accessibilite.material.tent.text") },
  { label: t("accessibilite.material.sleeping.label"), text: t("accessibilite.material.sleeping.text") },
  { label: t("accessibilite.material.flashlight.label"), text: t("accessibilite.material.flashlight.text") },
  { label: t("accessibilite.material.earplugs.label"), text: t("accessibilite.material.earplugs.text") },
  { label: t("accessibilite.material.medicine.label"), text: t("accessibilite.material.medicine.text") },
  { label: t("accessibilite.material.entertainment.label"), text: t("accessibilite.material.entertainment.text") },
];
---

<div class="page-hero anim">
  <p class="page-hero-eyebrow">✦ {t("accessibilite.hero.eyebrow")}</p>
  <h1 class="page-hero-title">{t("accessibilite.hero.title")}</h1>
  <p class="page-hero-sub">{t("accessibilite.hero.subtitle")}</p>
</div>

<div class="page-content accessibilite-page">
  <div class="reveal reveal-spacing">
    <div class="construction-banner">
      🚧 {t("accessibilite.hero.note")}
    </div>
  </div>

  <section id="intro" class="access-panel surface-card">
    <h2>{t("accessibilite.intro.title")}</h2>
    <p>{t("accessibilite.intro.p1")}</p>
    <p>{t("accessibilite.intro.p2")}</p>

    <p class="source-note">
      {t("accessibilite.intro.sourcePrefix")}
      <a
        href="https://lesdevalideuses.org/ressources-2/guides-accessibilite-2026/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-link-accent"
      >
        {t("accessibilite.intro.sourceLinkText")}
      </a>
    </p>

    <div class="access-info-card surface-card">
      <span class="info-card-icon">💡</span>
      <div class="info-card-body">
        <div class="info-card-title">{t("accessibilite.intro.definitionTitle")}</div>
        <p>{t("accessibilite.intro.definitionText")}</p>
      </div>
    </div>

    <div class="access-info-card surface-card">
      <span class="info-card-icon">⚠️</span>
      <div class="info-card-body">
        <div class="info-card-title">{t("accessibilite.intro.remarksTitle")}</div>
        <div class="info-card-warning">
          <p>{t("accessibilite.intro.remarksP1")}</p>
          <p>{t("accessibilite.intro.remarksP2")}</p>
          <p>{t("accessibilite.intro.remarksP3")}</p>
          <p>{t("accessibilite.intro.remarksP4")}</p>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section id="equipe-care" class="access-panel surface-card">
    <h2>🤲 {t("accessibilite.care.title")}</h2>
    <ul class="access-list">
      {careItems.map((item) => (
        <li class={`access-${item.type}`}>{item.text}</li>
      ))}
    </ul>
  </section>

  <section id="engagement" class="access-panel surface-card">
    <h2>🎪 {t("accessibilite.engagement.title")}</h2>
    <ul class="access-list">
      {engagementItems.map((item) => (
        <li class={`access-${item.type}`}>{item.text}</li>
      ))}
    </ul>
  </section>

  <section id="formation" class="access-panel surface-card">
    <h2>🛠️ {t("accessibilite.formation.title")}</h2>
    <ul class="access-list">
      {formationItems.map((item) => (
        <li class={`access-${item.type}`}>{item.text}</li>
      ))}
    </ul>
  </section>

  <hr class="divider" />

  <section id="dispositifs-generaux" class="access-panel surface-card">
    <h2>🌸 {t("accessibilite.general.title")}</h2>
    <ul class="access-list">
      {generalItems.map((item) => (
        <li class={`access-${item.type}`}>{item.text}</li>
      ))}
    </ul>
  </section>

  <section id="accessibilite-enfants" class="access-panel surface-card">
    <h2>🧒 {t("accessibilite.children.title")}</h2>
    <ul class="access-list">
      {childrenItems.map((item) => (
        <li class={`access-${item.type}`}>{item.text}</li>
      ))}
    </ul>
  </section>

  <section id="accessibilite-visuelle" class="access-panel surface-card">
    <h2>👁️ {t("accessibilite.visual.title")}</h2>
    <ul class="access-list">
      {visualItems.map((item) => (
        <li class={`access-${item.type}`}>{item.text}</li>
      ))}
    </ul>
  </section>

  <section id="accessibilite-auditive" class="access-panel surface-card">
    <h2>👂 {t("accessibilite.auditory.title")}</h2>
    <ul class="access-list">
      {auditoryItems.map((item) => (
        <li class={`access-${item.type}`}>{item.text}</li>
      ))}
    </ul>
  </section>


  <section id="accessibilite-spatiale" class="section-contrast">
    <div class="section-alt">
      <h2 class="section-contrast-title">📍 {t("accessibilite.spatial.title")}</h2>

      <div class="access-info-card surface-card access-spatial-alert">
        <span class="info-card-icon">⚠️</span>
        <div class="info-card-body">
          <div class="info-card-title">{t("accessibilite.spatial.alertTitle")}</div>
          <p>{t("accessibilite.spatial.alertText")}</p>
        </div>
      </div>

      <h3 class="section-contrast-title section-contrast-title--small">🚆 {t("accessibilite.spatial.railTitle")}</h3>
      <p class="section-contrast-content">{t("accessibilite.spatial.railText")}</p>

      <h3 class="section-contrast-title section-contrast-title--small">⛺ {t("accessibilite.spatial.terrainTitle")}</h3>
      <p class="section-contrast-content">{t("accessibilite.spatial.terrainText")}</p>

      <ul class="access-list access-list--contrast">
        {spatialItems.map((item) => (
          <li class={`access-${item.type}`}>
            <div>
              <div>{item.text}</div>
              {item.details && (
                <details class="plan-details">
                  <summary>{item.details.label}</summary>
                  <div class="plan-grid">
                    {item.details.images.map((src) => (
                      <img src={src} alt="Plan PMR près de l'entrée" class="plan-img" />
                    ))}
                  </div>
                </details>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="accessibilite-sensorielle" class="access-panel surface-card">
    <h2>🏞️ {t("accessibilite.sensorial.title")}</h2>
    <ul class="access-list">
      {sensorialItems.map((item) => (
        <li class={`access-${item.type}`}>{item.text}</li>
      ))}
    </ul>
  </section>

  <section id="accessibilite-cognitive" class="access-panel surface-card">
    <h2>🧠 {t("accessibilite.cognitive.title")}</h2>
    <ul class="access-list">
      {cognitiveItems.map((item) => (
        <li class={`access-${item.type}`}>{item.text}</li>
      ))}
    </ul>
  </section>

  <section id="accessibilite-sanitaire" class="access-panel surface-card">
    <h2>🧼 {t("accessibilite.sanitary.title")}</h2>
    <ul class="access-list">
      {sanitaryItems.map((item) => (
        <li class={`access-${item.type}`}>{item.text}</li>
      ))}
    </ul>
  </section>

  <hr class="divider" />

  <section id="materiel">
    <h2>🎒 {t("accessibilite.material.title")}</h2>
    <ul class="materiel-list">
      {materialItems.map((item) => (
        <li><strong>{item.label} :</strong> {item.text}</li>
      ))}
    </ul>
  </section>
</div>

