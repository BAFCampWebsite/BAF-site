---
import { getLocale } from "astro-intl";
import { getTranslations } from "../i18n/getTranslations";

const lang = getLocale();
const p = `/${lang}`;
const t = getTranslations("infos");

const espaceJeunesseBlocks = [
  {
    icon: "🌅",
    title: t("espaceJeunesse.morning.title"),
    html: t("espaceJeunesse.morning.html"),
  },
  {
    icon: "🌤️",
    title: t("espaceJeunesse.afternoon.title"),
    html: t("espaceJeunesse.afternoon.html"),
  },
  {
    icon: "🎨",
    title: t("espaceJeunesse.activities.title"),
    html: t("espaceJeunesse.activities.html"),
  },
  {
    icon: "💬",
    title: t("espaceJeunesse.contact.title"),
    prefix: t("espaceJeunesse.contact.prefix"),
    suffix: t("espaceJeunesse.contact.suffix"),
  },
];
const linkTag = (href: string) => (chunks: string) =>
  `<a href="${href}" target="_blank" rel="noopener noreferrer" class="text-link-accent">${chunks}</a>`;
const boldTag = (chunks: string) => `<span class="text-strong">${chunks}</span>`;

const mealBlocks = [
  { icon: "🥞", html: t("restauration.breakfast") },
  { icon: "🥗", html: t("restauration.lunch") },
  { icon: "🍽️", html: t("restauration.dinner") },
];

const otherBlocks: Array<{ icon: string; title: string; html: string }> = [
  { icon: "🐶", title: t("other.dogs.title"), html: t.markup("other.dogs.text", { bold: boldTag }) },
  { icon: "💸", title: t("other.cash.title"), html: t.markup("other.cash.text", { bold: boldTag }) },
  { icon: "🍾", title: t("other.glass.title"), html: t.markup("other.glass.text", { bold: boldTag }) },
  { icon: "☀️", title: t("other.heat.title"), html: t.markup("other.heat.text", { bold: boldTag }) },
  { icon: "🏊", title: t("other.swimming.title"), html: t.markup("other.swimming.text", { bold: boldTag }) },
  { icon: "🧼", title: t("other.washing.title"), html: t.markup("other.washing.text", { bold: boldTag }) },
  { icon: "👮", title: t("other.police.title"), html: t.markup("other.police.text", { bold: boldTag }) },
  { icon: "⛺", title: t("other.camping.title"), html: t.markup("other.camping.text", { bold: boldTag }) },
  {
    icon: "💳",
    title: t("other.bankTransfer.title"),
    html: t.markup("other.bankTransfer.text", {
      bold: boldTag,
      link: linkTag(`${p}/billetterie/#payment`),
    }),
  },
  {
    icon: "📣",
    title: t("other.signal.title"),
    html: t.markup("other.signal.text", {
      bold: boldTag,
      link: linkTag(
        "https://signal.group/#CjQKIG9fN5pPDbZpGm_gIZgsASV_4XidkI_wgNJ7lwBc8caaEhCAU3Kp2wWLrEnBIKp9bXQN",
      ),
    }),
  },
  { icon: "⛑️", title: t("other.medic.title"), html: t.markup("other.medic.text", { bold: boldTag }) },
  { icon: "📸", title: t("other.cameras.title"), html: t.markup("other.cameras.text", { bold: boldTag }) },
];
---

<div class="page-hero">
  <p class="page-hero-eyebrow">{t("hero.eyebrow")}</p>
  <h1 class="page-hero-title">{t("hero.title")}</h1>
  <p class="page-hero-sub">{t("hero.subtitle")}</p>
</div>

<div class="page-content">
  <div class="reveal-spacing">
    <div class="construction-banner">
      🚧 {t("construction")}
    </div>
  </div>

  <section id="acces">
    <p class="section-label">📍 {t("acces.sectionLabel")}</p>
    <h2>{t("acces.title")}</h2>

    <div class="info-grid">
      <div>
        <div class="info-card surface-card">
          <h3 class="info-card-title">🚆 {t("acces.train.title")}</h3>
          <p>{t("acces.train.text")}</p>
          <div class="info-card-warning">
            <strong>{t("acces.train.warningLabel")}</strong>
            <p>{t("acces.train.warningText")}</p>
            <a
              class="info-card-link"
              href={t("acces.train.linkUrl")}
              target="_blank"
              rel="noopener noreferrer"
            >
              {t("acces.train.linkLabel")}
            </a>
          </div>
        </div>
      </div>
      <div>
        <div class="info-card surface-card">
          <h3 class="info-card-title">🚲 {t("acces.velo.title")}</h3>
          <p>{t("acces.velo.text")}</p>
        </div>
      </div>
      <div>
        <div class="info-card surface-card">
          <h3 class="info-card-title">🚗 {t("acces.voiture.title")}</h3>
          <p>{t("acces.voiture.text")}</p>
          <div class="info-card-success">
            <strong>🤲 {t("acces.voiture.carpool.heading")}</strong>
            <p>{t("acces.voiture.carpool.text")}</p>
            <a
              class="info-card-link"
              href="https://hophub.xyz/e/baf-camp-2026-93cc4c"
              target="_blank"
              rel="noopener noreferrer"
            >
              {t("acces.voiture.carpool.linkLabel")}
            </a>
          </div>
        </div>
      </div>

      <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      />
      <div id="map" class="map-panel"></div>
    </div>
  </section>

  <hr class="divider" />

  <section id="restauration" class="section-contrast">
    <div class="page-content">
      <div class="section-alt">
        <p class="section-label">🍴 {t("restauration.sectionLabel")}</p>
        <h2 class="section-contrast-title">{t("restauration.title")}</h2>
        <!-- TODO: Food serving times (Breakfast, lunch, dinner) -->
        <p class="section-contrast-content" set:html={t("restauration.html")} />

        <h3 class="meals-title">{t("restauration.mealsTitle")}</h3>
        <div class="meals-grid">
          {
            mealBlocks.map((meal) => (
              <div class="meal-block">
                <span class="meal-icon">{meal.icon}</span>
                <p set:html={meal.html} />
              </div>
            ))
          }
        </div>
        <p class="section-contrast-content dietary-note" set:html={t("restauration.dietaryNote")} />
      </div>
    </div>
  </section>

  <section id="camping">
    <p class="section-label">⛺ {t("camping.sectionLabel")}</p>
    <h2>{t("camping.title")}</h2>
    <p set:html={t("camping.html")} />
    <p>{t("camping.mixiteText")}</p>

    <div class="info-block">
      <span class="info-block-icon">🗓️</span>
      <div class="info-block-body">
        <div class="info-block-title">{t("camping.dates.title")}</div>
        <p>{t("camping.dates.text")}</p>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section id="espace-jeunesse">
    <p class="section-label">🧒 {t("espaceJeunesse.sectionLabel")}</p>
    <h2>{t("espaceJeunesse.title")}</h2>
    <p
      style="font-family:var(--font-serif); font-size:.93rem; line-height:1.8;"
      set:html={t("espaceJeunesse.introHtml")}
    />

    {
      espaceJeunesseBlocks.map((block) => (
        <div class="info-block surface-card">
          <span class="info-block-icon">{block.icon}</span>
          <div class="info-block-body">
            <div class="info-block-title">{block.title}</div>
            {block.html ? (
              <p set:html={block.html} />
            ) : (
              <p>
                {block.prefix}
                <a
                  href="mailto:contact@bafcamp.be"
                  class="text-link-accent"
                >
                  contact@bafcamp.be
                </a>
                {block.suffix}
              </p>
            )}
          </div>
        </div>
      ))
    }
  </section>

  <hr class="divider" />

  <section id="other">
    <p class="section-label">❓ {t("other.sectionLabel")}</p>
    <h2>{t("other.title")}</h2>

    <div class="cards-grid cards-grid--max-5">
      {
        otherBlocks.map((block) => (
          <div class="card">
            <span class="card-icon">{block.icon}</span>
            <div class="card-title">{block.title}</div>
            <div class="card-text" set:html={block.html} />
          </div>
        ))
      }
    </div>
  </section>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
  // Leaflet is loaded via the external script above. suppress TS checks here.
  // @ts-ignore
  const map = L.map("map", { scrollWheelZoom: false }).setView(
    [49.9072, 5.2697],
    15,
  );
  // @ts-ignore
  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    attribution: "© OpenStreetMap contributors",
    maxZoom: 19,
  }).addTo(map);
  // @ts-ignore
  L.marker([50.0923867580313, 5.277445980713076])
    .addTo(map)
    .bindPopup(
      "<strong>BAF Camp</strong><br>1 chemin de Lavaux<br>6927 Tellin, Belgique",
    )
    .openPopup();
</script>

<style is:global>
  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin-bottom: 48px;
  }
  .info-card {
    background: var(--blanc-sale);
    border: var(--contour-lg);
    border-radius: 12px;
    padding: 28px 24px;
    box-shadow: var(--ombre-lg);
    transition: transform 0.15s;
    position: relative;
    overflow: hidden;
  }
  .info-card::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    background: var(--rose);
    border-radius: 12px 12px 0 0;
  }
  .info-card:nth-child(2n)::after {
    background: var(--vert);
  }
  .info-card:hover {
    transform: translate(-3px, -3px);
  }
  .info-card-icon {
    font-size: 2rem;
    margin-bottom: 12px;
    display: block;
  }
  .info-card-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: 0.04em;
    color: var(--vert);
    margin-bottom: 10px;
  }
  .info-card p {
    font-family: var(--font-serif);
    font-size: 0.84rem;
    line-height: 1.7;
    color: var(--gris-encre);
    margin-bottom: 0;
  }
  .info-card-link {
    display: inline-block;
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rose);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .info-card-warning {
    margin-top: 10px;
    padding: 12px 14px;
    border: 2px solid #c62828;
    border-radius: 10px;
    background: #ffe2e2;
    box-shadow: 4px 4px 0 #c62828;
  }
  .info-card-warning strong {
    display: block;
    margin-bottom: 4px;
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: #8e1d1d;
  }
  .info-card-warning p {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 0.82rem;
    line-height: 1.6;
    color: #8e1d1d;
  }

  .info-card-success {
    margin-top: 10px;
    padding: 12px 14px;
    border: 2px solid var(--vert-dark);
    border-radius: 10px;
    background: #d4edda;
    box-shadow: 4px 4px 0 var(--vert-dark);
  }
  .info-card-success strong {
    display: block;
    margin-bottom: 4px;
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--vert-dark);
  }
  .info-card-success p {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--vert-dark);
  }

  .section-alt {
    background: var(--rose);
    margin: 0 -80px;
    padding: 48px 80px;
    border-top: 3px solid var(--encre);
    border-bottom: 3px solid var(--encre);
    position: relative;
    overflow: hidden;
  }
  .section-alt::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.08) 1px,
      transparent 1px
    );
    background-size: 14px 14px;
    pointer-events: none;
  }
  .section-alt h2 {
    color: var(--creme) !important;
  }
  .meals-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    letter-spacing: 0.04em;
    color: var(--creme);
    margin-top: 32px;
    margin-bottom: 12px;
  }
  .meals-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
  }
  .meal-block {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px 16px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 8px;
  }
  .meal-icon {
    font-size: 1.4rem;
    line-height: 1;
    flex-shrink: 0;
  }
  .meal-block p {
    font-family: var(--font-serif);
    font-size: 0.84rem;
    line-height: 1.7;
    color: var(--creme);
    margin: 0;
  }
  .dietary-note {
    margin-top: 16px;
    font-style: italic;
  }
  .section-alt .info-card-title {
    color: var(--rose);
  }
  .section-alt .info-card::after {
    background: var(--vert);
  }
  .section-alt .info-card:nth-child(2n)::after {
    background: var(--rose-dark);
  }

  .info-block {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    padding: 20px;
    background: var(--blanc-sale);
    border: var(--contour);
    border-radius: 10px;
    box-shadow: var(--ombre);
    margin-bottom: 16px;
    transition: transform 0.15s;
  }
  .info-block:hover {
    transform: translate(-2px, -2px);
  }
  .info-block-icon {
    font-size: 1.8rem;
    flex-shrink: 0;
    line-height: 1;
  }
  .info-block-body {
  }
  .info-block-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--vert);
    margin-bottom: 6px;
  }
  .info-block p {
    font-family: var(--font-serif);
    font-size: 0.84rem;
    line-height: 1.7;
    color: var(--gris-encre);
    margin-bottom: 0;
  }

  .cards-grid--max-5 {
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }
  @media (min-width: 1201px) {
  .card .text-strong {
    color: var(--rose-dark);
    font-weight: 900;
  }

  .cards-grid--max-5 {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    background: var(--vert);
    color: var(--creme);
    padding: 4px 12px;
    border-radius: 4px;
    border: 1px solid var(--encre);
    box-shadow: 2px 2px 0 var(--encre);
    margin-bottom: 14px;
  }

  @media (max-width: 900px) {
    .section-alt {
      margin: 0 -20px;
      padding: 40px 20px;
    }
  }
</style>
