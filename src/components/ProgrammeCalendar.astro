---
import { getLocale } from "astro-intl";
import { getTranslations } from "../i18n/getTranslations";
import teamupEvents from "../../public/teamup-events.json";
import {
  buildCalendarEvents,
  buildDayFilters,
  buildLocationFilters,
  buildCategoryMeta,
} from "../lib/calendar";
import CalendarFilters from "./CalendarFilters.astro";
import EventModal from "./EventModal.astro";
import "../styles/calendar/base.css";
import "../styles/calendar/cards.css";
import "../styles/calendar/list.css";
import "../styles/calendar/timeline.css";
import "../styles/calendar/print.css";

const lang = getLocale();
const t = getTranslations("programme");
const addToCalendarLabel = t("calendar.addToCalendar");
const viewCardsLabel = t("calendar.view.cards");
const viewTimelineLabel = t("calendar.view.timeline");
const viewListLabel = t("calendar.view.list");
const showFiltersLabel = t("calendar.showFilters");
const hideFiltersLabel = t("calendar.hideFilters");
const noLocationLabel = t("calendar.noLocation");
const noEventsMessage = t("calendar.noEvents");
const timelineOtherLabel = t("calendar.timelineOther");
const modalLabels = {
  date: t("calendar.modalLabels.date"),
  time: t("calendar.modalLabels.time"),
  language: t("calendar.modalLabels.language"),
  location: t("calendar.modalLabels.location"),
  hostedBy: t("calendar.modalLabels.hostedBy"),
  age: t("calendar.modalLabels.age"),
  warnings: t("calendar.modalLabels.warnings"),
};

const categoryMeta = buildCategoryMeta(t);
const calendarEvents = buildCalendarEvents(
  (teamupEvents?.events ?? []) as Record<string, unknown>[],
  lang,
  categoryMeta,
  t("calendar.filters.workshops"),
);
const dayFilters = buildDayFilters(calendarEvents, lang);
const locationFilters = buildLocationFilters(calendarEvents, noLocationLabel, timelineOtherLabel);
---

<div class="calendar-wrap" style="margin-top:40px;">
  <div class="calendar-shell">
    <div class="calendar-special-card">
      <span class="calendar-special-label">{t("calendar.title")}</span>
      <div class="calendar-special-content" set:html={t("dayContent.i1")} />
    </div>

    <div class="calendar-toolbar" aria-label="View switcher">
      <button class="calendar-view-toggle active" type="button" data-view="timeline">
        {viewTimelineLabel}
      </button>
      <button class="calendar-view-toggle" type="button" data-view="cards">
        {viewCardsLabel}
      </button>
      <!-- List view temporarily disabled; code kept for future re-enable. -->
      <!--
      <button class="calendar-view-toggle" type="button" data-view="list">
        {viewListLabel}
      </button>
      -->
      <button class="calendar-filters-toggle" type="button" data-toggle-filters aria-expanded="false">
        <span class="calendar-filters-toggle-icon" aria-hidden="true"></span>
        <span class="calendar-filters-toggle-label">{showFiltersLabel}</span>
      </button>
    </div>

    <CalendarFilters dayFilters={dayFilters} locationFilters={locationFilters} />

    <div class="construction-banner">⚠ {t("construction")}</div>

    <div id="calendarEvents" class="calendar-grid"></div>
    <script type="application/json" data-calendar-data set:html={JSON.stringify({
      calendarEvents,
      addToCalendarLabel,
      noLocationLabel,
      noEventsMessage,
      timelineOtherLabel,
      showFiltersLabel,
      hideFiltersLabel,
      modalLabels,
    })}></script>
  </div>
</div>

<EventModal />

<script>
  import {
    escapeHtml,
    renderCard,
    renderTimeline,
    renderList,
    getNowInfo,
    downloadCalendarEvent,
  } from "../lib/calendar-client";
  import { createEventModal } from "../lib/calendar-modal";
  import { createTimelineNow } from "../lib/calendar-timeline";

  const calendarData = JSON.parse(
    document.querySelector("[data-calendar-data]")?.textContent || "{}"
  );
  const { calendarEvents, addToCalendarLabel, noLocationLabel, noEventsMessage, timelineOtherLabel, showFiltersLabel, hideFiltersLabel, modalLabels } = calendarData;
  const labels = modalLabels || {};
  const eventCards = calendarEvents || [];
  const buttons = Array.from(document.querySelectorAll(".calendar-filter"));
  const container = document.getElementById("calendarEvents");
  const filtersToggle = document.querySelector("[data-toggle-filters]");
  const filterPanel = document.querySelector("[data-filter-panel]");
  const modal = createEventModal({ addToCalendarLabel, labels });
  const timelineNow = createTimelineNow({ container });
  let activeCategory = "all";
  let activeDay = "all";
  let activeLocation = "all";
  let activeChildren = false;
  let activeView = "timeline";
  let activeSearch = "";
  let searchTimeout = null;

  // Initialise state from URL params so views and filters are shareable.
  const urlParams = new URLSearchParams(window.location.search);
  const validViews = new Set(["timeline", "cards", "list"]);
  const validDays = new Set(
    Array.from(document.querySelectorAll('.calendar-filter[data-day]')).map((b) => b.dataset.day),
  );
  const validCategories = new Set(
    Array.from(document.querySelectorAll('.calendar-filter[data-category]')).map((b) => b.dataset.category),
  );
  const validLocations = new Set(
    Array.from(document.querySelectorAll('.calendar-filter[data-location]')).map((b) => b.dataset.location),
  );

  const urlView = urlParams.get("view");
  if (urlView && validViews.has(urlView)) activeView = urlView;
  const urlDay = urlParams.get("day");
  if (urlDay && validDays.has(urlDay)) activeDay = urlDay;
  const urlCategory = urlParams.get("category");
  if (urlCategory && validCategories.has(urlCategory)) activeCategory = urlCategory;
  const urlLocation = urlParams.get("location");
  if (urlLocation && validLocations.has(urlLocation)) activeLocation = urlLocation;
  const urlChildren = urlParams.get("children");
  if (urlChildren === "1") activeChildren = true;
  const urlSearch = (urlParams.get("search") || "").trim();
  if (urlSearch) activeSearch = urlSearch.toLowerCase();

  function renderEvents() {
    const visibleEvents = eventCards.filter((event) => {
      const matchesCategory =
        activeCategory === "all" ? true : (event.categories || []).includes(activeCategory);
      const matchesDay = activeDay === "all" ? true : event.dayKey === activeDay;
      const matchesLocation =
        activeLocation === "all" ? true : event.locationKey === activeLocation;
      const matchesChildren = activeChildren ? Boolean(event.childFriendly) : true;
      if (!activeSearch) return matchesCategory && matchesDay && matchesLocation && matchesChildren;
      const haystack = [
        event.title || "",
        event.notesText || event.notes || "",
        event.who || "",
        event.language || "",
        event.childFriendly || "",
        event.warnings || "",
      ].join(" ").toLowerCase();
      return matchesCategory && matchesDay && matchesLocation && matchesChildren && haystack.includes(activeSearch);
    });

    if (!container) return;

    if (!visibleEvents.length) {
      container.innerHTML = `<div class="calendar-empty">${noEventsMessage}</div>`;
      timelineNow.syncNowButton();
      return;
    }

    if (activeView === "timeline") {
      container.innerHTML = renderTimeline(visibleEvents, activeDay, noLocationLabel, timelineOtherLabel, getNowInfo(new Date()));
      timelineNow.syncNowButton();
      return;
    }

    if (activeView === "list") {
      container.innerHTML = renderList(visibleEvents, activeDay, addToCalendarLabel);
      timelineNow.syncNowButton();
      return;
    }

    if (activeDay !== "all") {
      container.innerHTML = `<div class="calendar-day-grid">${visibleEvents.map(renderCard).join("")}</div>`;
      timelineNow.syncNowButton();
    } else {
      const dayKeys = [...new Set(visibleEvents.map((e) => e.dayKey))];
      container.innerHTML = dayKeys.map((dayKey) => {
        const dayEvents = visibleEvents.filter((e) => e.dayKey === dayKey);
        const dayLabel = escapeHtml(dayEvents[0].dayLabel || dayKey);
        return `
          <div class="calendar-day-section">
            <h2 class="calendar-day-heading">${dayLabel}</h2>
            <div class="calendar-day-grid">${dayEvents.map(renderCard).join("")}</div>
          </div>
        `;
      }).join("");
      timelineNow.syncNowButton();
    }
  }

  function syncUrl() {
    const params = new URLSearchParams();
    if (activeView !== "timeline") params.set("view", activeView);
    if (activeDay !== "all") params.set("day", activeDay);
    if (activeCategory !== "all") params.set("category", activeCategory);
    if (activeLocation !== "all") params.set("location", activeLocation);
    if (activeChildren) params.set("children", "1");
    if (activeSearch) params.set("search", activeSearch);
    const query = params.toString();
    const url = query ? `${window.location.pathname}?${query}` : window.location.pathname;
    history.replaceState(null, "", url);
  }

  function updateClearButtons() {
    const dayClear = document.querySelector('[data-clear="day"]');
    const catClear = document.querySelector('[data-clear="category"]');
    const locClear = document.querySelector('[data-clear="location"]');
    const childrenClear = document.querySelector('[data-clear="children"]');
    if (dayClear) {
      dayClear.style.display = activeDay === "all" ? "none" : "";
      dayClear.disabled = activeDay === "all";
    }
    if (catClear) {
      catClear.style.display = activeCategory === "all" ? "none" : "";
      catClear.disabled = activeCategory === "all";
    }
    if (locClear) {
      locClear.style.display = activeLocation === "all" ? "none" : "";
      locClear.disabled = activeLocation === "all";
    }
    if (childrenClear) {
      childrenClear.style.display = activeChildren ? "" : "none";
      childrenClear.disabled = !activeChildren;
    }
  }

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      if (button.dataset.day) {
        const dayButtons = Array.from(document.querySelectorAll('.calendar-filter[data-day]'));
        activeDay = button.classList.contains("active") ? "all" : (button.dataset.day || "all");
        dayButtons.forEach((item) => item.classList.toggle("active", item === button && activeDay !== "all"));
      } else if (button.dataset.location) {
        const locationButtons = Array.from(document.querySelectorAll('.calendar-filter[data-location]'));
        activeLocation = button.classList.contains("active") ? "all" : (button.dataset.location || "all");
        locationButtons.forEach((item) => item.classList.toggle("active", item === button && activeLocation !== "all"));
      } else if (button.dataset.children) {
        activeChildren = !activeChildren;
        button.classList.toggle("active", activeChildren);
      } else {
        const categoryButtons = Array.from(document.querySelectorAll('.calendar-filter[data-category]'));
        activeCategory = button.classList.contains("active") ? "all" : (button.dataset.category || "all");
        categoryButtons.forEach((item) => item.classList.toggle("active", item === button && activeCategory !== "all"));
      }
      updateClearButtons();
      syncUrl();
      renderEvents();
    });
  });

  const clearButtons = Array.from(document.querySelectorAll(".calendar-filter-clear"));
  clearButtons.forEach((clearBtn) => {
    clearBtn.addEventListener("click", () => {
      const type = clearBtn.dataset.clear;
      if (type === "day") {
        activeDay = "all";
        document.querySelectorAll('.calendar-filter[data-day]').forEach((b) => b.classList.remove("active"));
      } else if (type === "category") {
        activeCategory = "all";
        document.querySelectorAll('.calendar-filter[data-category]').forEach((b) => b.classList.remove("active"));
      } else if (type === "location") {
        activeLocation = "all";
        document.querySelectorAll('.calendar-filter[data-location]').forEach((b) => b.classList.remove("active"));
      } else if (type === "children") {
        activeChildren = false;
        document.querySelectorAll('.calendar-filter[data-children]').forEach((b) => b.classList.remove("active"));
      }
      updateClearButtons();
      syncUrl();
      renderEvents();
    });
  });

  const viewToggles = Array.from(document.querySelectorAll(".calendar-view-toggle"));
  viewToggles.forEach((toggle) => {
    toggle.addEventListener("click", () => {
      activeView = toggle.dataset.view || "cards";
      viewToggles.forEach((item) => item.classList.toggle("active", item === toggle));
      syncUrl();
      renderEvents();
    });
  });

  filtersToggle?.addEventListener("click", () => {
    if (!filterPanel) return;
    const isOpen = filterPanel.hidden === false;
    filterPanel.hidden = isOpen;
    filterPanel.dataset.userOpened = "1";
    filtersToggle.setAttribute("aria-expanded", String(!isOpen));
    const label = filtersToggle.querySelector(".calendar-filters-toggle-label");
    if (label) label.textContent = isOpen ? showFiltersLabel : hideFiltersLabel;
  });

  const searchInput = document.querySelector(".calendar-search-input");
  searchInput?.addEventListener("input", () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
      activeSearch = (searchInput.value || "").toLowerCase().trim();
      syncUrl();
      renderEvents();
    }, 250);
  });

  container?.addEventListener("click", (event) => {
    const addButton = event.target.closest("[data-add-to-calendar]");
    if (addButton) {
      const row = addButton.closest("[data-event-id]");
      const addToEvent = eventCards.find((item) => String(item.id) === row?.getAttribute("data-event-id"));
      if (addToEvent) downloadCalendarEvent(addToEvent);
      return;
    }
    const card = event.target.closest(".calendar-card, .timeline-event, .calendar-list-item");
    if (!card) return;
    const selectedEvent = eventCards.find((item) => String(item.id) === card.getAttribute("data-event-id"));
    if (selectedEvent) {
      modal.openModal(selectedEvent);
    }
  });

  // Reflect URL state in the UI controls.
  viewToggles.forEach((toggle) => toggle.classList.toggle("active", toggle.dataset.view === activeView));
  document.querySelectorAll('.calendar-filter[data-day]').forEach((b) => b.classList.toggle("active", b.dataset.day === activeDay));
  document.querySelectorAll('.calendar-filter[data-category]').forEach((b) => b.classList.toggle("active", b.dataset.category === activeCategory));
  document.querySelectorAll('.calendar-filter[data-location]').forEach((b) => b.classList.toggle("active", b.dataset.location === activeLocation));
  document.querySelectorAll('.calendar-filter[data-children]').forEach((b) => b.classList.toggle("active", activeChildren));
  if (searchInput && urlSearch) searchInput.value = urlSearch;

  // Keep the filter panel open on mobile when the URL carries active filters,
  // so the applied state stays visible.
  const hasActiveFilters = activeDay !== "all" || activeCategory !== "all" || activeLocation !== "all" || activeChildren || Boolean(activeSearch);
  if (hasActiveFilters && filterPanel) filterPanel.dataset.userOpened = "1";

  renderEvents();
  updateClearButtons();

  const mobileQuery = window.matchMedia("(max-width: 640px)");
  function applyResponsiveFilters() {
    if (!filterPanel || !filtersToggle) return;
    if (mobileQuery.matches) {
      if (filterPanel.hidden === false && !filterPanel.dataset.userOpened) {
        filterPanel.hidden = true;
        filtersToggle.setAttribute("aria-expanded", "false");
        const label = filtersToggle.querySelector(".calendar-filters-toggle-label");
        if (label) label.textContent = showFiltersLabel;
      } else if (filterPanel.hidden === false) {
        // Panel kept open (e.g. filters applied via URL): reflect open state.
        filtersToggle.setAttribute("aria-expanded", "true");
      }
    } else {
      filterPanel.hidden = false;
      filtersToggle.setAttribute("aria-expanded", "true");
    }
  }
  applyResponsiveFilters();
  mobileQuery.addEventListener?.("change", applyResponsiveFilters);
</script>
