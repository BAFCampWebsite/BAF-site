---
import { getLocale } from "astro-intl";
import { getTranslations } from "../i18n/getTranslations";
import teamupEvents from "../../public/teamup-events.json";

const lang = getLocale();
const t = getTranslations("programme");
const addToCalendarLabel = t("calendar.addToCalendar");
const searchPlaceholder = t("calendar.searchPlaceholder");
const viewCardsLabel = t("calendar.view.cards");
const viewTimelineLabel = t("calendar.view.timeline");
const noLocationLabel = t("calendar.noLocation");
const noEventsMessage = t("calendar.noEvents");

const SUBCALENDAR_ID_MAP = {
  "15782183": "CONFERENCE",
  "15782182": "FILM",
  "15766557": "MUSIC",
  "15782184": "THEATRE",
  "15766558": "WORKSHOPS",
};

const categoryMeta = {
  CONFERENCE: {
    accent: "var(--rose)",
    label: t("calendar.filters.conference"),
  },
  FILM: {
    accent: "var(--bleu)",
    label: t("calendar.filters.film"),
  },
  MUSIC: {
    accent: "#9b4d4d",
    label: t("calendar.filters.music"),
  },
  THEATRE: {
    accent: "#3f6f4f",
    label: t("calendar.filters.theatre"),
  },
  WORKSHOPS: {
    accent: "#5e4b9b",
    label: t("calendar.filters.workshops"),
  },
};

const getNotesText = (notes = "") => {
  const normalized = String(notes || "")
    .replace(/<br\s*\/?>/gi, "\n")
    .replace(/<\/p>\s*<p>/gi, "\n")
    .replace(/<[^>]+>/g, " ")
    .replace(/\u00a0/g, " ")
    .replace(/[ \t]+/g, " ")
    .replace(/\s*\n\s*/g, "\n")
    .replace(/\n{2,}/g, "\n")
    .trim();

  return normalized;
};

const getFirstCommentText = (comments = []) => {
  if (!comments?.length) return "";
  return getNotesText(comments[0].message || "");
};

const calendarEvents = (teamupEvents?.events ?? [])
  .map((event) => {
    const start = new Date(event.start_dt);
    const end = new Date(event.end_dt);
    const notesText = getNotesText(event.notes);
    const languageNote = getFirstCommentText(event.comments);
    const previewText = notesText
      ? notesText.split(/\r?\n/)[0].trim()
      : "";

    const brusselsParts = new Intl.DateTimeFormat("en-CA", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
      hourCycle: "h23",
      timeZone: "Europe/Brussels",
    }).formatToParts(start);
    const brParts = (type) => brusselsParts.find((p) => p.type === type)?.value;
    const brYear = Number(brParts("year"));
    const brMonth = Number(brParts("month"));
    const brDay = Number(brParts("day"));
    const brHour = Number(brParts("hour"));

    const realDay = new Date(Date.UTC(brYear, brMonth - 1, brDay));
    const effectiveDay = new Date(realDay);
    if (brHour < 3) effectiveDay.setUTCDate(effectiveDay.getUTCDate() - 1);

    const dayKey = new Intl.DateTimeFormat("en-CA", {
      timeZone: "UTC",
    }).format(effectiveDay);
    const dayLabel = new Intl.DateTimeFormat(lang, {
      weekday: "long",
      day: "numeric",
      month: "short",
      timeZone: "UTC",
    }).format(effectiveDay);

    const dateLabel = new Intl.DateTimeFormat(lang, {
      weekday: "short",
      day: "numeric",
      month: "short",
      timeZone: "UTC",
    }).format(effectiveDay);

    const realDateLabel = new Intl.DateTimeFormat(lang, {
      weekday: "short",
      day: "numeric",
      month: "short",
      timeZone: "UTC",
    }).format(realDay);

    const timeLabel = `${start.toLocaleTimeString(lang, {
      hour: "2-digit",
      minute: "2-digit",
      hourCycle: "h23",
      timeZone: "Europe/Brussels",
    })} — ${end.toLocaleTimeString(lang, {
      hour: "2-digit",
      minute: "2-digit",
      hourCycle: "h23",
      timeZone: "Europe/Brussels",
    })}`;

    const ids = event.subcalendar_ids?.length
      ? event.subcalendar_ids
      : [event.subcalendar_id];

    const seen = new Set();
    const cats = [];
    ids.forEach((id) => {
      const cat = SUBCALENDAR_ID_MAP[String(id)] ?? "WORKSHOPS";
      if (seen.has(cat)) return;
      seen.add(cat);
      cats.push(cat);
    });
    cats.sort((a) => (a === "FILM" ? -1 : 1));

    return {
      ...event,
      categories: cats,
      accents: cats.map((c) => categoryMeta[c]?.accent ?? "var(--gris-encre)"),
      labels: cats.map((c) => categoryMeta[c]?.label ?? t("calendar.filters.workshops")),
      locationKey: String(event.location || "").trim().toLowerCase() || "__none__",
      dayKey,
      dayLabel,
      dateLabel,
      realDateLabel,
      timeLabel,
      notesText,
      previewText,
      languageNote,
      isPlaceholder: !previewText,
    };
  })
  .sort((a, b) => new Date(a.start_dt) - new Date(b.start_dt));

const dayFilters = Array.from(new Set(calendarEvents.map((event) => event.dayKey))).map(
  (dayKey) => {
    const date = new Date(dayKey);
    return {
      dayKey,
      label: new Intl.DateTimeFormat(lang, {
        weekday: "long",
        day: "numeric",
        month: "short",
        timeZone: "UTC",
      }).format(date),
    };
  }
);

const locationFilters = Array.from(
  new Set(calendarEvents.map((event) => event.locationKey))
)
  .sort()
  .map((locationKey) => {
    const sample = calendarEvents.find((event) => event.locationKey === locationKey);
    const raw = String(sample?.location || "").trim();
    return {
      locationKey,
      label: raw || noLocationLabel,
    };
  });
---

<div style="margin-top:40px;">
  <div class="calendar-shell">
    <div class="calendar-special-card">
      <span class="calendar-special-label">{t("calendar.title")}</span>
      <div class="calendar-special-content" set:html={t("dayContent.i1")} />
    </div>

    <div class="calendar-toolbar" aria-label="View switcher">
      <button class="calendar-view-toggle active" type="button" data-view="cards">
        {viewCardsLabel}
      </button>
      <button class="calendar-view-toggle" type="button" data-view="timeline">
        {viewTimelineLabel}
      </button>
    </div>

    <div class="calendar-filter-panel">
      <div class="calendar-filter-row">
        <span class="calendar-filter-label">{t("calendar.filterLabels.day")}</span>
        <div class="calendar-filter-options">
          <button class="calendar-filter-clear" type="button" data-clear="day" disabled>
            ✕ {t("calendar.clear")}
          </button>
          {
            dayFilters.map((day) => (
              <button class="calendar-filter" data-day={day.dayKey}>
                {day.label}
              </button>
            ))
          }
        </div>
      </div>

      <div class="calendar-filter-row">
        <span class="calendar-filter-label">{t("calendar.filterLabels.type")}</span>
        <div class="calendar-filter-options">
          <button class="calendar-filter-clear" type="button" data-clear="category" disabled>
            ✕ {t("calendar.clear")}
          </button>
          <button class="calendar-filter" data-category="CONFERENCE">
            {t("calendar.filters.conference")}
          </button>
          <button class="calendar-filter" data-category="FILM">
            {t("calendar.filters.film")}
          </button>
          <button class="calendar-filter" data-category="MUSIC">
            {t("calendar.filters.music")}
          </button>
          <button class="calendar-filter" data-category="THEATRE">
            {t("calendar.filters.theatre")}
          </button>
          <button class="calendar-filter" data-category="WORKSHOPS">
            {t("calendar.filters.workshops")}
          </button>
        </div>
      </div>

      <div class="calendar-filter-row">
        <span class="calendar-filter-label">{t("calendar.filterLabels.location")}</span>
        <div class="calendar-filter-options">
          <button class="calendar-filter-clear" type="button" data-clear="location" disabled>
            ✕ {t("calendar.clear")}
          </button>
          {
            locationFilters.map((loc) => (
              <button class="calendar-filter" data-location={loc.locationKey}>
                {loc.label}
              </button>
            ))
          }
        </div>
      </div>

      <div class="calendar-filter-row">
        <span class="calendar-filter-label">{t("calendar.filterLabels.search")}</span>
        <div class="calendar-filter-options">
          <input class="calendar-search-input" type="search" placeholder={searchPlaceholder} aria-label={searchPlaceholder}>
        </div>
      </div>
    </div>
    <div class="construction-banner">⚠ {t("construction")}</div>

    <div id="calendarEvents" class="calendar-grid"></div>
  </div>
</div>

<div id="eventModal" class="calendar-modal" aria-hidden="true">
  <div class="calendar-modal-backdrop" data-close-modal></div>
  <div class="calendar-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="eventModalTitle">
    <button class="calendar-modal-close" type="button" aria-label="Close" data-close-modal>
      ×
    </button>
    <div id="eventModalContent"></div>
  </div>
</div>

<style is:global>
  .calendar-shell {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .calendar-special-card {
    background: var(--blanc-sale);
    border: var(--contour-lg);
    border-radius: 16px;
    padding: 24px;
    box-shadow: var(--ombre-lg);
  }
  .calendar-special-label,
  .calendar-card-date,
  .calendar-card-category,
  .calendar-modal-meta-item strong,
  .calendar-modal-badge,
  .calendar-filter {
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .calendar-special-label {
    display: inline-block;
    font-size: 0.68rem;
    color: var(--gris-encre);
    margin-bottom: 10px;
    letter-spacing: 0.16em;
  }
  .calendar-special-content p,
  .calendar-card-meta-item,
  .calendar-card-preview,
  .calendar-modal-meta-item,
  .calendar-modal-notes,
  .calendar-empty {
    font-family: var(--font-serif);
    color: var(--encre);
  }
  .calendar-special-content p {
    font-size: 0.95rem;
    line-height: 1.8;
    margin: 0;
  }
  .calendar-filter-panel {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border: var(--contour);
    border-radius: 16px;
    padding: 16px;
    background: var(--blanc-sale);
    box-shadow: var(--ombre);
  }
  .calendar-filter-row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .calendar-filter-label {
    flex: 0 0 90px;
    padding-top: 9px;
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.62rem;
    color: var(--gris-encre);
  }
  .calendar-filter-options {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }
  .calendar-filter-clear {
    border: var(--contour);
    border-radius: 999px;
    background: transparent;
    color: var(--gris-encre);
    padding: 8px 14px;
    font-size: 0.66rem;
    cursor: pointer;
    opacity: 0.75;
  }
  .calendar-filter-clear:hover:not(:disabled) {
    color: var(--encre);
    opacity: 1;
  }
  .calendar-filter-clear:disabled {
    cursor: default;
    opacity: 0.3;
  }
  .calendar-filter {
    border: var(--contour);
    border-radius: 999px;
    background: var(--blanc-sale);
    color: var(--encre);
    padding: 8px 14px;
    font-size: 0.68rem;
    cursor: pointer;
    box-shadow: var(--ombre);
  }
  .calendar-filter[data-day] { background: var(--creme); }
  .calendar-filter.active {
    background: var(--rose);
    color: white;
    border-color: var(--rose);
  }
  .calendar-search-input {
    border: var(--contour);
    border-radius: 999px;
    background: var(--blanc-sale);
    color: var(--encre);
    padding: 8px 14px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    outline: none;
    max-width: 260px;
    width: 100%;
    box-shadow: var(--ombre);
  }
  .calendar-search-input:focus {
    border-color: var(--rose);
    box-shadow: var(--ombre), 0 0 0 2px color-mix(in srgb, var(--rose) 30%, transparent);
  }
  .calendar-view-toggle {
    border: var(--contour);
    border-radius: 999px;
    background: var(--blanc-sale);
    color: var(--encre);
    padding: 8px 14px;
    font-size: 0.68rem;
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: var(--ombre);
  }
  .calendar-view-toggle.active {
    background: var(--encre);
    color: var(--blanc-sale);
    border-color: var(--encre);
  }
  .calendar-grid {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .calendar-day-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .calendar-day-heading {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    color: var(--gris-encre);
    padding-bottom: 4px;
    border-bottom: 2px solid var(--sable);
  }
  .calendar-day-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .calendar-card {
    background: var(--blanc-sale);
    border: 1px solid var(--sable);
    border-left: 6px solid var(--rose);
    border-radius: 16px;
    padding: 20px;
    box-shadow: var(--ombre);
    display: flex;
    flex-direction: column;
    gap: 12px;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .calendar-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--ombre-lg);
  }
  .calendar-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .calendar-card-top-right {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-left: auto;
  }
  .calendar-card-time {
    font-size: 0.72rem;
    color: var(--gris-encre);
    white-space: nowrap;
  }
  .calendar-card-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .calendar-card-category {
    display: inline-flex;
    align-self: flex-start;
    border-radius: 999px;
    padding: 4px 10px;
    font-size: 0.63rem;
    color: white;
    background: var(--rose);
  }
  .calendar-card-date {
    font-size: 0.72rem;
    color: var(--gris-encre);
  }
  .calendar-card h3 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.4;
  }
  .calendar-card-meta-grid,
  .calendar-modal-meta {
    display: grid;
    gap: 8px;
    padding: 12px;
    border-radius: 12px;
    background: var(--creme);
    border: 1px solid var(--sable);
  }
  .calendar-card-meta-item,
  .calendar-modal-meta-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .calendar-card-language,
  .calendar-modal-language {
    font-size: 0.8rem;
    font-style: italic;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }
  .calendar-card-meta-item span:first-child {
    font-size: 0.95rem;
    line-height: 1.2;
    min-width: 1.1rem;
  }
  .calendar-card-preview {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .calendar-card-preview.is-placeholder {
    display: block;
    text-align: center;
    font-style: italic;
    color: var(--gris-encre);
    opacity: 0.8;
    padding-top: 2px;
  }
  .calendar-modal {
    position: fixed;
    inset: 0;
    z-index: 10003;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .calendar-modal.is-open { display: flex; }
  .calendar-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 15, 15, 0.62);
    backdrop-filter: blur(3px);
  }
  .calendar-modal-dialog {
    position: relative;
    width: min(720px, 100%);
    max-height: min(85vh, 900px);
    overflow: auto;
    background: var(--blanc-sale);
    border: var(--contour-lg);
    border-radius: 20px;
    box-shadow: var(--ombre-lg);
    padding: 28px;
  }
  .calendar-modal-close {
    position: absolute;
    top: 12px;
    right: 12px;
    border: none;
    background: transparent;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--gris-encre);
  }
  .calendar-modal-title {
    margin: 0 0 12px;
    font-size: 1.3rem;
    line-height: 1.3;
  }
  .calendar-modal-body { display: grid; gap: 14px; }
  .calendar-modal-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .calendar-modal-badge {
    display: inline-flex;
    align-self: flex-start;
    border-radius: 999px;
    padding: 4px 10px;
    font-size: 0.63rem;
    color: white;
  }
  .calendar-modal-meta-item strong {
    font-size: 0.7rem;
    color: var(--gris-encre);
    min-width: 90px;
  }
  .calendar-modal-notes {
    white-space: pre-wrap;
    font-size: 0.95rem;
    line-height: 1.8;
    margin: 0;
  }
  .calendar-modal-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    padding: 10px 14px;
    border: none;
    border-radius: 999px;
    background: var(--rose);
    color: white;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    box-shadow: var(--ombre);
  }
  .calendar-modal-action:hover {
    opacity: 0.92;
  }
  .calendar-empty {
    border: 1px dashed var(--sable);
    border-radius: 14px;
    padding: 24px;
    text-align: center;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .timeline {
    --tl-hour-height: 60px;
    --tl-gutter-width: 56px;
    --tl-row-pad: 6px;
    border: var(--contour);
    border-radius: 16px;
    background: var(--blanc-sale);
    box-shadow: var(--ombre);
    overflow: hidden;
  }
  .timeline-header {
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--sable);
    background: var(--creme);
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.63rem;
    color: var(--gris-encre);
  }
  .timeline-corner {
    flex: 0 0 var(--tl-gutter-width);
  }
  .timeline-loc-header {
    flex: 1 1 0;
    min-width: 0;
    padding: 10px var(--tl-row-pad);
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    border-left: 1px solid var(--sable);
  }
  .timeline-body {
    display: flex;
    position: relative;
  }
  .timeline-gutter,
  .timeline-track {
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent calc(var(--tl-hour-height) - 1px),
      var(--sable) calc(var(--tl-hour-height) - 1px),
      var(--sable) var(--tl-hour-height)
    );
  }
  .timeline-track {
    flex: 1 1 0;
    min-width: 0;
    position: relative;
    border-left: 1px solid var(--sable);
  }
  .timeline-gutter {
    flex: 0 0 var(--tl-gutter-width);
    position: relative;
    border-right: 1px solid var(--sable);
  }
  .timeline-hour {
    position: absolute;
    right: 6px;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--gris-encre);
    white-space: nowrap;
    background: var(--blanc-sale);
    padding: 0 4px;
  }
  .timeline-event {
    position: absolute;
    left: var(--tl-row-pad);
    right: var(--tl-row-pad);
    overflow: hidden;
    border: 1px solid var(--sable);
    border-left: 4px solid var(--rose);
    border-radius: 8px;
    background: var(--creme);
    padding: 4px 6px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 2px;
    box-shadow: var(--ombre);
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  .timeline-event:hover {
    transform: translateY(-1px);
    box-shadow: var(--ombre-lg);
    z-index: 2;
  }
  .timeline-event-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    flex-wrap: wrap;
  }
  .timeline-event-time {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--gris-encre);
    white-space: nowrap;
  }
  .timeline-event-badges {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 3px;
    margin-left: auto;
  }
  .timeline-event-badge {
    display: inline-flex;
    border-radius: 999px;
    padding: 1px 6px;
    font-family: var(--font-mono);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: white;
    white-space: nowrap;
    line-height: 1.4;
  }
  .timeline-event-title {
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--encre);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .timeline-event-language {
    align-self: flex-start;
    font-size: 0.55rem;
    font-style: italic;
    color: var(--gris-encre);
    line-height: 1.5;
    white-space: nowrap;
    padding-right: 2px;
  }
  .timeline-scroll {
    overflow-x: auto;
  }
  .timeline-day-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  @media (max-width: 1024px) { .calendar-day-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .calendar-day-grid { grid-template-columns: 1fr; } }
</style>

<script
  define:vars={{
    calendarEvents,
    addToCalendarLabel,
    viewCardsLabel,
    viewTimelineLabel,
    noLocationLabel,
    noEventsMessage,
  }}>
  const eventCards = calendarEvents || [];
  const buttons = Array.from(document.querySelectorAll(".calendar-filter"));
  const container = document.getElementById("calendarEvents");
  const modal = document.getElementById("eventModal");
  const modalContent = document.getElementById("eventModalContent");
  const closeButtons = Array.from(document.querySelectorAll("[data-close-modal]"));
  let activeCategory = "all";
  let activeDay = "all";
  let activeLocation = "all";
  let activeView = "cards";
  let activeEvent = null;
  let activeSearch = "";
  let searchTimeout = null;

  function escapeHtml(value) {
    return String(value)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#39;");
  }

  function escapeIcsText(value) {
    return String(value)
      .replace(/\r\n?/g, "\n")
      .replace(/\n/g, "\\n")
      .replace(/\\/g, "\\\\")
      .replace(/;/g, "\\;")
      .replace(/,/g, "\\,");
  }

  function toIcsDate(value) {
    const date = new Date(value);
    return date.toISOString().replace(/[-:]/g, "").replace(/\.\d{3}Z$/, "Z");
  }

  function createCalendarFile(event) {
    const title = (event.title || "Untitled event").replace(/\r?\n/g, " ");
    const location = (event.location || "").replace(/\r?\n/g, " ");
    const description = (event.notesText || event.notes || "").replace(/\r?\n/g, "\n");
    const start = toIcsDate(event.start_dt);
    const end = toIcsDate(event.end_dt);
    const ics = [
      "BEGIN:VCALENDAR",
      "VERSION:2.0",
      "PRODID:-//BAF//Programme//EN",
      "CALSCALE:GREGORIAN",
      "BEGIN:VEVENT",
      `UID:${event.id || Date.now()}@baf-site`,
      `DTSTAMP:${toIcsDate(new Date())}`,
      `DTSTART:${start}`,
      `DTEND:${end}`,
      `SUMMARY:${escapeIcsText(title)}`,
      description ? `DESCRIPTION:${escapeIcsText(description)}` : "",
      location ? `LOCATION:${escapeIcsText(location)}` : "",
      "END:VEVENT",
      "END:VCALENDAR",
    ]
      .filter(Boolean)
      .join("\r\n");

    return URL.createObjectURL(new Blob([ics], { type: "text/calendar;charset=utf-8" }));
  }

  function downloadCalendarEvent(event) {
    if (!event) return;
    const url = createCalendarFile(event);
    const link = document.createElement("a");
    const filename = String(event.title || "event")
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-|-$/g, "") || "event";

    link.href = url;
    link.download = `${filename}.ics`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    setTimeout(() => URL.revokeObjectURL(url), 0);
  }

  function openModal(event) {
    if (!modal || !modalContent) return;
    activeEvent = event;
    const title = escapeHtml(event.title || "Untitled event");
    const dateLabel = escapeHtml(event.realDateLabel || event.dayLabel || event.dateLabel || "");
    const timeLabel = escapeHtml(event.timeLabel || "");
    const location = event.location ? escapeHtml(event.location) : "";
    const who = event.who ? escapeHtml(event.who) : "";
    const languageNote = event.languageNote ? escapeHtml(event.languageNote) : "";
    const notes = event.notesText ? escapeHtml(event.notesText).replace(/\n/g, "<br>") : "";
    const modalBadges = (event.labels || [])
      .map((label, i) => {
        const bg = (event.accents && event.accents[i]) || "var(--rose)";
        return `<span class="calendar-modal-badge" style="background:${bg};">${escapeHtml(label)}</span>`;
      })
      .join("") || `<span class="calendar-modal-badge" style="background:var(--rose);">Event</span>`;

    modalContent.innerHTML = `
      <div class="calendar-modal-body">
        <div class="calendar-modal-badges">${modalBadges}</div>
        <h3 id="eventModalTitle" class="calendar-modal-title">${title}</h3>
        <div class="calendar-modal-meta">
          <div class="calendar-modal-meta-item"><strong>Date</strong><span>${dateLabel}</span></div>
          <div class="calendar-modal-meta-item"><strong>Time</strong><span>${timeLabel}</span></div>
          ${languageNote ? `<div class="calendar-modal-meta-item"><strong>Language</strong><span class="calendar-modal-language">${languageNote}</span></div>` : ""}
          ${location ? `<div class="calendar-modal-meta-item"><strong>Location</strong><span>${location}</span></div>` : ""}
          ${who ? `<div class="calendar-modal-meta-item"><strong>Hosted by</strong><span>${who}</span></div>` : ""}
        </div>
        ${notes ? `<p class="calendar-modal-notes">${notes}</p>` : ""}
        <button type="button" class="calendar-modal-action" data-add-to-calendar>${addToCalendarLabel}</button>
      </div>
    `;

    const addToCalendarButton = modalContent.querySelector("[data-add-to-calendar]");
    addToCalendarButton?.addEventListener("click", (event) => {
      event.preventDefault();
      if (activeEvent) {
        downloadCalendarEvent(activeEvent);
      }
    });

    modal.classList.add("is-open");
    modal.setAttribute("aria-hidden", "false");
  }

  function closeModal() {
    if (!modal) return;
    activeEvent = null;
    modal.classList.remove("is-open");
    modal.setAttribute("aria-hidden", "true");
  }

  function renderCard(event) {
    const title = escapeHtml(event.title || "Untitled event");
    const dateLabel = escapeHtml(event.dateLabel || "");
    const timeLabel = escapeHtml(event.timeLabel || "");
    const location = event.location ? escapeHtml(event.location) : "";
    const who = event.who ? escapeHtml(event.who) : "";
    const languageNote = event.languageNote ? escapeHtml(event.languageNote) : "";
    const preview = event.previewText ? escapeHtml(event.previewText) : "";
    const previewClass = event.isPlaceholder ? "calendar-card-preview is-placeholder" : "calendar-card-preview";
    const accent = (event.accents && event.accents[0]) || "var(--rose)";
    const badges = (event.labels || [])
      .map((label, i) => {
        const bg = (event.accents && event.accents[i]) || "var(--rose)";
        return `<span class="calendar-card-category" style="background:${bg};">${escapeHtml(label)}</span>`;
      })
      .join("");

    return `
      <article class="calendar-card" data-event-id="${event.id}" style="border-left-color:${accent};">
        <div class="calendar-card-top">
          <span class="calendar-card-date">${dateLabel}</span>
          <div class="calendar-card-top-right">
            <span class="calendar-card-time">${timeLabel}</span>
            <div class="calendar-card-categories">${badges}</div>
          </div>
        </div>
        <h3>${title}</h3>
        <div class="calendar-card-meta-grid">
          ${languageNote ? `<div class="calendar-card-meta-item"><span>💬</span><span class="calendar-card-language">${languageNote}</span></div>` : ""}
          ${location ? `<div class="calendar-card-meta-item"><span>🎪</span><span>${location}</span></div>` : ""}
          ${who ? `<div class="calendar-card-meta-item"><span>👤</span><span>${who}</span></div>` : ""}
        </div>
        ${preview ? `<p class="${previewClass}">${preview}</p>` : ""}
      </article>
    `;
  }

  function getMinutes(value) {
    const date = new Date(value);
    const brussels = new Intl.DateTimeFormat("en-GB", {
      hour: "2-digit",
      minute: "2-digit",
      hourCycle: "h23",
      timeZone: "Europe/Brussels",
    }).format(date);
    const [hh, mm] = brussels.split(":").map(Number);
    return hh * 60 + mm;
  }

  function getLocationLabel(event) {
    const loc = String(event.location || "").trim();
    return loc ? loc : noLocationLabel;
  }

  function getDayMinutes(value, dayKey) {
    const date = new Date(value);
    const brusselsDate = new Intl.DateTimeFormat("en-CA", {
      timeZone: "Europe/Brussels",
    }).format(date);
    const mins = getMinutes(value);
    const eventDay = new Date(brusselsDate + "T00:00:00Z").getTime();
    const keyDay = new Date(dayKey + "T00:00:00Z").getTime();
    const diffDays = Math.round((eventDay - keyDay) / 86400000);
    return mins + diffDays * 24 * 60;
  }

  function renderTimelineEvent(event, dayStartMin, dayKey) {
    const startMin = getDayMinutes(event.start_dt, dayKey);
    const endMin = getDayMinutes(event.end_dt, dayKey);
    const top = startMin - dayStartMin;
    const height = Math.max(endMin - startMin, 34);
    const accent = (event.accents && event.accents[0]) || "var(--rose)";
    const title = escapeHtml(event.title || "Untitled event");
    const timeLabel = escapeHtml(event.timeLabel || "");
    const languageNote = event.languageNote ? escapeHtml(event.languageNote) : "";
    const badges = (event.labels || [])
      .map((label, i) => {
        const bg = (event.accents && event.accents[i]) || "var(--rose)";
        return `<span class="timeline-event-badge" style="background:${bg};">${escapeHtml(label)}</span>`;
      })
      .join("");

    return `
      <div
        class="timeline-event"
        data-event-id="${event.id}"
        style="top:${top}px;height:${height}px;border-left-color:${accent};"
        title="${title}"
      >
        <div class="timeline-event-head">
          <span class="timeline-event-time">${timeLabel}</span>
          <span class="timeline-event-badges">${badges}</span>
        </div>
        ${languageNote ? `<span class="timeline-event-language">💬 ${languageNote}</span>` : ""}
        <span class="timeline-event-title">${title}</span>
      </div>
    `;
  }

  function renderTimelineDay(dayKey, dayEvents) {
    const startTimes = dayEvents.map((e) => getDayMinutes(e.start_dt, dayKey));
    const endTimes = dayEvents.map((e) => getDayMinutes(e.end_dt, dayKey));
    let dayStart = Math.floor(Math.min(...startTimes) / 60) * 60;
    let dayEnd = Math.max(Math.ceil(Math.max(...endTimes) / 60) * 60, Math.max(...endTimes) + 30);
    if (dayEnd <= dayStart) dayEnd = dayStart + 24 * 60;

    const hourLabels = [];
    for (let m = dayStart; m <= dayEnd; m += 60) {
      const hh = String((Math.floor(m / 60) % 24)).padStart(2, "0");
      hourLabels.push(`<span class="timeline-hour" style="top:${m - dayStart}px;">${hh}:00</span>`);
    }

    const locations = Array.from(
      new Set(dayEvents.map((e) => String(e.location || "").trim().toLowerCase()))
    ).sort();
    if (locations.length === 0) locations.push("");

    const headers = locations
      .map((loc) => {
        const sample = dayEvents.find(
          (e) => String(e.location || "").trim().toLowerCase() === loc
        );
        const label = escapeHtml(getLocationLabel(sample));
        return `<div class="timeline-loc-header" title="${label}">${label}</div>`;
      })
      .join("");

    const tracks = locations
      .map((loc) => {
        const events = dayEvents.filter(
          (e) => String(e.location || "").trim().toLowerCase() === loc
        );
        const inner = events.map((e) => renderTimelineEvent(e, dayStart, dayKey)).join("");
        return `<div class="timeline-track">${inner}</div>`;
      })
      .join("");

    const heightPx = dayEnd - dayStart;
    const dayLabel = escapeHtml(dayEvents[0].dayLabel || dayKey);
    const minWidth = Math.max(locations.length * 150 + 70, 520);

    return `
      <div class="timeline-day-section">
        <h2 class="calendar-day-heading">${dayLabel}</h2>
        <div class="timeline-scroll">
          <div class="timeline" style="min-width:${minWidth}px;">
            <div class="timeline-header">
              <div class="timeline-corner"></div>
              ${headers}
            </div>
            <div class="timeline-body" style="height:${heightPx}px;">
              <div class="timeline-gutter">${hourLabels.join("")}</div>
              ${tracks}
            </div>
          </div>
        </div>
      </div>
    `;
  }

  function renderTimeline(visibleEvents) {
    if (activeDay !== "all") {
      return renderTimelineDay(activeDay, visibleEvents);
    }
    const dayKeys = [...new Set(visibleEvents.map((e) => e.dayKey))];
    return dayKeys
      .map((dayKey) => renderTimelineDay(dayKey, visibleEvents.filter((e) => e.dayKey === dayKey)))
      .join("");
  }

  function renderEvents() {
    const visibleEvents = eventCards.filter((event) => {
      const matchesCategory =
        activeCategory === "all" ? true : (event.categories || []).includes(activeCategory);
      const matchesDay = activeDay === "all" ? true : event.dayKey === activeDay;
      const matchesLocation =
        activeLocation === "all" ? true : event.locationKey === activeLocation;
      if (!activeSearch) return matchesCategory && matchesDay && matchesLocation;
      const haystack = [
        event.title || "",
        event.notesText || event.notes || "",
        event.who || "",
        event.languageNote || "",
      ].join(" ").toLowerCase();
      return matchesCategory && matchesDay && matchesLocation && haystack.includes(activeSearch);
    });

    if (!container) return;

    if (!visibleEvents.length) {
      container.innerHTML = `<div class="calendar-empty">${noEventsMessage}</div>`;
      return;
    }

    if (activeView === "timeline") {
      container.innerHTML = renderTimeline(visibleEvents);
      return;
    }

    if (activeDay !== "all") {
      container.innerHTML = `<div class="calendar-day-grid">${visibleEvents.map(renderCard).join("")}</div>`;
    } else {
      const dayKeys = [...new Set(visibleEvents.map((e) => e.dayKey))];
      container.innerHTML = dayKeys.map((dayKey) => {
        const dayEvents = visibleEvents.filter((e) => e.dayKey === dayKey);
        const dayLabel = escapeHtml(dayEvents[0].dayLabel || dayKey);
        return `
          <div class="calendar-day-section">
            <h2 class="calendar-day-heading">${dayLabel}</h2>
            <div class="calendar-day-grid">${dayEvents.map(renderCard).join("")}</div>
          </div>
        `;
      }).join("");
    }
  }

  function updateClearButtons() {
    const dayClear = document.querySelector('[data-clear="day"]');
    const catClear = document.querySelector('[data-clear="category"]');
    const locClear = document.querySelector('[data-clear="location"]');
    if (dayClear) dayClear.disabled = activeDay === "all";
    if (catClear) catClear.disabled = activeCategory === "all";
    if (locClear) locClear.disabled = activeLocation === "all";
  }

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      if (button.dataset.day) {
        const dayButtons = Array.from(document.querySelectorAll('.calendar-filter[data-day]'));
        activeDay = button.classList.contains("active") ? "all" : (button.dataset.day || "all");
        dayButtons.forEach((item) => item.classList.toggle("active", item === button && activeDay !== "all"));
      } else if (button.dataset.location) {
        const locationButtons = Array.from(document.querySelectorAll('.calendar-filter[data-location]'));
        activeLocation = button.classList.contains("active") ? "all" : (button.dataset.location || "all");
        locationButtons.forEach((item) => item.classList.toggle("active", item === button && activeLocation !== "all"));
      } else {
        const categoryButtons = Array.from(document.querySelectorAll('.calendar-filter[data-category]'));
        activeCategory = button.classList.contains("active") ? "all" : (button.dataset.category || "all");
        categoryButtons.forEach((item) => item.classList.toggle("active", item === button && activeCategory !== "all"));
      }
      updateClearButtons();
      renderEvents();
    });
  });

  const clearButtons = Array.from(document.querySelectorAll(".calendar-filter-clear"));
  clearButtons.forEach((clearBtn) => {
    clearBtn.addEventListener("click", () => {
      const type = clearBtn.dataset.clear;
      if (type === "day") {
        activeDay = "all";
        document.querySelectorAll('.calendar-filter[data-day]').forEach((b) => b.classList.remove("active"));
      } else if (type === "category") {
        activeCategory = "all";
        document.querySelectorAll('.calendar-filter[data-category]').forEach((b) => b.classList.remove("active"));
      } else if (type === "location") {
        activeLocation = "all";
        document.querySelectorAll('.calendar-filter[data-location]').forEach((b) => b.classList.remove("active"));
      }
      updateClearButtons();
      renderEvents();
    });
  });

  const viewToggles = Array.from(document.querySelectorAll(".calendar-view-toggle"));
  viewToggles.forEach((toggle) => {
    toggle.addEventListener("click", () => {
      activeView = toggle.dataset.view || "cards";
      viewToggles.forEach((item) => item.classList.toggle("active", item === toggle));
      renderEvents();
    });
  });

  const searchInput = document.querySelector(".calendar-search-input");
  searchInput?.addEventListener("input", () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
      activeSearch = (searchInput.value || "").toLowerCase().trim();
      renderEvents();
    }, 250);
  });

  container?.addEventListener("click", (event) => {
    const card = event.target.closest(".calendar-card, .timeline-event");
    if (!card) return;
    const selectedEvent = eventCards.find((item) => String(item.id) === card.getAttribute("data-event-id"));
    if (selectedEvent) {
      openModal(selectedEvent);
    }
  });

  closeButtons.forEach((button) => {
    button.addEventListener("click", closeModal);
  });

  modal?.addEventListener("click", (event) => {
    if (event.target === modal) {
      closeModal();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeModal();
    }
  });

  renderEvents();
</script>
