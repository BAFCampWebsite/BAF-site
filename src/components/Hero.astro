---
import { getLocale } from 'astro-intl';
import { getTranslations } from '../i18n/getTranslations';

const lang = getLocale();
const p = `/${lang}`;
const t = getTranslations('hero');
---

<input type="file" id="heroInput" accept="image/*">

<section class="hero" id="hero-section">
  <div class="hero-bg">
    <img id="heroImg" src="" alt="" class="hero-image-fade">
    <div class="hero-bg-overlay"></div>
  </div>

  <div class="hero-inner">
      <div class="hero-content">
      <div class="hero-logo">
        <img src="/BAF%20Logo.png" alt="BAF Camp" id="heroLogoImg">
        <div class="hero-nextyear">{t('nextYear')}</div>
      </div>
    </div>
    <div class="hero-right">
      <p class="page-hero-sub">{t('thankYouStayInTouch')}</p>
      <div class="hero-actions">
        <a href="https://signal.group/#CjQKIG9fN5pPDbZpGm_gIZgsASV_4XidkI_wgNJ7lwBc8caaEhCAU3Kp2wWLrEnBIKp9bXQN" class="btn btn-primary">{t('btnSignal')}</a>
        <a href="https://stats.sender.net/forms/b82Jlr/view" class="btn btn-outline-hero">{t('btnMailingList')}</a>
      </div>
      <p class="page-hero-sub">{t('saveTheDate2026GetInvolved')}</p>
    </div>
  </div>
</section>
