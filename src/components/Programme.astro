---
import { getLocale } from "astro-intl";
import { getTranslations } from "../i18n/getTranslations";
import ProgrammeCalendar from "./ProgrammeCalendar.astro";

const lang = getLocale();
const t = getTranslations("programme");

const spaceItems = [
  {
    icon: "🔥",
    title: t("spaces.items.i0.title"),
    text: t("spaces.items.i0.text"),
  },
  {
    icon: "❤️",
    title: t("spaces.items.i1.title"),
    text: t("spaces.items.i1.text"),
  },
  {
    icon: "📚",
    title: t("spaces.items.i2.title"),
    text: t("spaces.items.i2.text"),
  },
  {
    icon: "🌊",
    title: t("spaces.items.i3.title"),
    text: t("spaces.items.i3.text"),
  },
];
---

<div class="page-hero">
  <p class="page-hero-eyebrow">✦ {t("hero.eyebrow")}</p>
  <h1 class="page-hero-title">{t("hero.title")}</h1>
  <p class="page-hero-sub">{t("hero.subtitle")}</p>
</div>

<div class="now-jump-wrap" data-now-jump-wrap hidden>
  <button type="button" class="now-jump-button" data-jump-to-now>
    <span class="now-jump-dot" aria-hidden="true"></span>
    {t("calendar.jumpToNow")}
  </button>
</div>

<div class="page-content">


  <div>
    <h2>{t("intro.title")}</h2>
    <p>{t("intro.sentence")}</p>
    <div class="cards-grid">
      <div class="card reveal">
        <h3 class="card-title">🤲 "{t("intro.together.title")}"</h3>
        <p class="card-tagline">{t("intro.together.tagline")}</p>
        <p class="card-text">{t("intro.together.explanation")}</p>
      </div>
      <div class="card reveal">
        <h3 class="card-title">🫯 "{t("intro.struggle.title")}"</h3>
        <p class="card-tagline">{t("intro.struggle.tagline")}</p>
        <p class="card-text">{t("intro.struggle.explanation")}</p>
      </div>
    </div>
  </div>

  <!-- <div class="reveal centre">
    <svg class="titre-fil" viewBox="0 0 600 120">
      <path
        id="filPath"
        d="M10,60 Q150,10 300,60 T590,60"
        fill="none"
        stroke="none"></path>
      <text class="fil-texte">
        <textPath href="#filPath" startOffset="50%" text-anchor="middle"
          >{t("filRouge.title")}</textPath
        >
      </text>
    </svg>
    <div class="bloc-fil">{t("filRouge.text")}</div>
  </div> -->

  <ProgrammeCalendar />

  <hr class="divider" />

  <div>
    <h2>{t("spaces.title")}</h2>
    <div class="cards-grid">
      {
        spaceItems.map((item) => (
          <div class="card reveal">
            <span class="card-icon">
              {item.icon}
            </span>
            <h3 class="card-title">{item.title}</h3>
            <p class="card-text">{item.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style is:global>
  .centre {
    text-align: center;
  }
  .titre-fil {
    display: block;
    margin: 0 auto;
    max-width: 500px;
    width: 100%;
  }
  .fil-texte {
    fill: none;
    stroke: #c40000;
    stroke-width: 1.2;
    font-size: 20px;
    font-family: cursive;
    letter-spacing: 1px;
  }
  .now-jump-wrap {
    display: flex;
    justify-content: center;
    padding: 24px 20px 2px;
  }
  .now-jump-wrap[hidden] {
    display: none;
  }
  .now-jump-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: var(--contour);
    border-radius: 999px;
    background: var(--vert);
    box-shadow: var(--ombre-vert);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--creme);
    padding: 14px 28px;
    cursor: pointer;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  .now-jump-button:hover {
    transform: translateY(-2px);
    box-shadow: 5px 5px 0 var(--vert-dark);
  }
  .now-jump-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--rose-dark);
    box-shadow: 0 0 0 4px var(--rose-a20);
  }
  .bloc-fil {
    margin: 20px auto;
    padding: 20px;
    max-width: 500px;
    text-align: center;
    border: 2px dashed #c40000;
    border-radius: 20px;
    font-size: 16px;
  }
</style>
